TROUTE_PORT=8080
# Non-container runs default to .local/troute when this is unset.
TROUTE_DATA_DIR=.local/troute
# Required. Every optimization builds its matrix from tcache pair Route Jobs.
TCACHE_BASE_URL=http://localhost:3200
TCACHE_POLL_INTERVAL_MS=250
TCACHE_REQUEST_TIMEOUT_MS=30000
# Deprecated fallback names: TCACHE_MATRIX_POLL_INTERVAL_MS, TCACHE_MATRIX_TIMEOUT_MS
# Optional positive integer. When unset, background Jobs are not semaphore-limited.
# TROUTE_MAX_CONCURRENT_JOBS=4
# Host loopback port for Docker Compose. Port 8080 is reserved for SFTPGo.
TROUTE_HOST_PORT=18080
# Testbed host port. Its /api proxy reaches troute on the Docker network.
TROUTE_TESTBED_PORT=8081
VITE_TROUTE_API_BASE_URL=/api
# Leave unset until a testbed route endpoint is configured.
VITE_TROUTE_ROUTE_PATH=
