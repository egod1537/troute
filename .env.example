TROUTE_PORT=8080
# Optional Trasolve backend URL for local, non-container execution.
# TRASOLVE_BASE_URL=http://127.0.0.1:43127
# Enable bounded in-memory job timelines for the local developer testbed.
TROUTE_ENABLE_TESTBED_OBSERVATION=true
# Optional host port override for Docker Compose (defaults to 8080).
TROUTE_HOST_PORT=8080
# Testbed host port. Its /api proxy reaches troute on the Docker network.
TROUTE_TESTBED_PORT=8081
VITE_TROUTE_API_BASE_URL=/api
# Leave unset until a route endpoint is actually implemented.
VITE_TROUTE_ROUTE_PATH=
