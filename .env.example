TROUTE_PORT=8080
# Non-container runs default to .local/troute when this is unset.
TROUTE_DATA_DIR=.local/troute
# Required. Every optimization builds its matrix from tcache pair Route Jobs.
TCACHE_BASE_URL=http://localhost:3200
TCACHE_POLL_INTERVAL_MS=250
TCACHE_REQUEST_TIMEOUT_MS=30000
TCACHE_PAIR_CONCURRENCY=4
TCACHE_MATRIX_TOTAL_TIMEOUT_MS=120000
# Deprecated fallback names: TCACHE_MATRIX_POLL_INTERVAL_MS, TCACHE_MATRIX_TIMEOUT_MS
# Default requests without a caller-supplied matrix to local straight-line estimates.
TROUTE_DEFAULT_EUCLIDEAN_MATRIX=true
# Route provider policy. Non-auto ROUTE_PROVIDER forces every routed request.
ROUTE_PROVIDER=auto
ROUTE_PROVIDER_POLICY_JSON=
ROUTE_PROVIDER_OVERRIDE_ENABLED=false
# Deprecated compatibility only. Used only when policy JSON omits JP + TRANSIT.
JAPAN_TRANSIT_PROVIDER=ekispert
# Finite admission and provider-work limits. Values must be positive integers.
TROUTE_MAX_CONCURRENT_JOBS=4
TROUTE_MAX_OUTSTANDING_JOBS=100
TROUTE_MAX_CONCURRENT_MATRIX_PREVIEWS=2
TROUTE_MAX_ROUTING_PAIRS=10000
# Fast validation and verified repairs share one dedicated Linux logical CPU.
TROUTE_VALIDATION_CPU=auto
TROUTE_MAX_QUEUED_VALIDATIONS=16
# External strategies are opt-in. SCIP also requires a feature-enabled binary.
SOLVER_ENABLE_MIP_SCIP=false
SOLVER_MIP_SCIP_TIMEOUT_MS=30000
SOLVER_MIP_SCIP_THREADS=1
SOLVER_MIP_SCIP_MEMORY_MB=1024
SOLVER_ENABLE_LKH3=false
# LKH3_EXECUTABLE=/absolute/path/to/LKH
SOLVER_LKH3_TIMEOUT_MS=30000
SOLVER_LKH3_SEED=42
SOLVER_COMPARE_ALL=false
SOLVER_INCUMBENT_EXCHANGE=false
# Portfolio scheduler defaults preserve the legacy CURRENT behavior.
SOLVER_PORTFOLIO_POLICY=CURRENT
SOLVER_CPU_SLOTS=4
SOLVER_POLICY_SEED=42
SOLVER_POLICY_MIN_QUANTUM_MS=250
SOLVER_RACING_WARMUP_RUNS=1
SOLVER_UCB_EXPLORATION=1.41421356237
SOLVER_MIN_EXPLORATION_RATIO=0.1
SOLVER_MAX_STARVATION_RUNS=8
SOLVER_POLICY_WEIGHTS_JSON=
SOLVER_TELEMETRY_MODE=SUMMARY
SOLVER_TELEMETRY_MAX_EVENTS=10000
SOLVER_MAX_EXTERNAL_PROCESSES=1
# SOLVER_MEMORY_LIMIT_MB=4096
TROUTE_PORTFOLIO_EXPERIMENT_ENABLED=false
# Opt-in Docker feature list, for example solver-mip-scip.
TROUTE_CARGO_FEATURES=
# Failure analysis runs after optimization or fast-validation failure.
TROUTE_REMEDIATION_BUDGET_MS=500
TROUTE_REMEDIATION_MAX_REMOVE_PROBES=8
TROUTE_MAX_FAILURE_SUGGESTIONS=3
# Host loopback port for Docker Compose. Port 8080 is reserved for SFTPGo.
TROUTE_HOST_PORT=18080
# Testbed host port. Its /api proxy reaches troute on the Docker network.
TROUTE_TESTBED_PORT=8081
VITE_TROUTE_API_BASE_URL=/api
VITE_TROUTE_ROUTE_PATH=/optimize
