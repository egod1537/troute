# Browser-visible URL; /api uses the same-origin development/container proxy.
VITE_TROUTE_API_BASE_URL=/api
# Used only by the Vite development server. Match your local API port.
TROUTE_DEV_PROXY_TARGET=http://127.0.0.1:8080
# No route endpoint exists yet. Set this only when a backend implements one.
VITE_TROUTE_ROUTE_PATH=
